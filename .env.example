# Server Configuration
PORT=8081

# Database Configuration (Local MySQL)
DB_URL=jdbc:mysql://localhost:3306/marketplace_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=marketplace_user
DB_PASSWORD=your_secure_db_password_here

# JWT Security
JWT_SECRET=your_base64_jwt_secret_key_here

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:3000

# Mail Configuration
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=noreply@servenow.com
MAIL_PASSWORD=

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# AI Service Microservice Configuration (Phase 2)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=your_secure_internal_service_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
